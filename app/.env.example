# Lawleit front-end environment — copy to .env (or .env.local) and edit.
# All values optional; defaults shown.

# Data source: "mock" (default — seeded localStorage backend, zero setup)
#              | "http" (REST client → VITE_API_BASE_URL, see docs/BACKEND.md)
VITE_API_MODE=mock

# Base URL used when VITE_API_MODE=http.
# Dev with the reference backend via the vite proxy: leave at /api/v1
#   (run `npm run dev:http`, or `node backend/server.mjs` + `npm run dev`)
# Direct cross-origin (no proxy): http://127.0.0.1:8787/api/v1
# Production: https://api.your-domain.com/v1
VITE_API_BASE_URL=/api/v1

# Dev-only: where the vite proxy forwards /api/* when set
# (npm run dev:http sets this automatically to http://127.0.0.1:8787)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
