# Required — signs session tokens; boot refuses to start without it
SESSION_SECRET=change-me

# Optional — comma-separated allow-list of browser origins allowed to call the
# API with credentials (the Vercel origins per ADR-0004). Empty or unset means
# same-origin/proxied traffic only.
CORS_ORIGINS=http://localhost:5173

# Optional — Supabase Postgres connection string (Mumbai region per ADR-0002).
# Validated at boot; the database itself is wired in ticket 06.
# DATABASE_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres

# Optional — HTTP port (default 3001)
# PORT=3001
