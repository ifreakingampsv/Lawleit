# Required — boot refuses to start without it. Opaque session tokens are not
# signed (ADR-0005), so nothing consumes it today; it is kept mandatory so the
# production environment is already carrying a real secret.
SESSION_SECRET=change-me

# Optional — comma-separated allow-list of browser origins allowed to call the
# API with credentials (the Vercel origins per ADR-0004). Empty or unset means
# same-origin/proxied traffic only.
CORS_ORIGINS=http://localhost:5173

# Optional — Postgres connection string (Supabase Mumbai per ADR-0002, used as
# a plain database). Unset = the API runs stateless and /health reports
# db:"unconfigured". `npm run dev`, `npm run db:migrate` and drizzle-kit all
# load this file (from the backend/ directory) automatically.
#
# Direct connection (simplest for migrate + a long-running API):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler (IPv4-friendly client, same behavior as direct):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (:6543, PgBouncer — the client sees pgbouncer=true and
# disables prepared statements itself):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Local Postgres (no TLS) must opt out explicitly:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lawleit?sslmode=disable

# Optional — session cookie knobs (ticket 07). Defaults (SameSite=Lax, no
# Secure) match the reference backend and same-origin/proxied deploys. The
# production cross-site deploy (ticket 19: Vercel frontend, Fly API) must set
# COOKIE_SAMESITE=none AND COOKIE_SECURE=true — browsers ignore SameSite=None
# without Secure.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Optional — HTTP port (default 3001)
# PORT=3001
