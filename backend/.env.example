# Required — boot refuses to start without it. Opaque session tokens are not
# signed (ADR-0005), so nothing consumes it today; it is kept mandatory so the
# production environment is already carrying a real secret.
SESSION_SECRET=change-me

# Optional — comma-separated allow-list of browser origins allowed to call the
# API with credentials (the Vercel origins per ADR-0004). Empty or unset means
# same-origin/proxied traffic only.
CORS_ORIGINS=http://localhost:5173

# Optional — Postgres connection string (Supabase Mumbai per ADR-0002, used as
# a plain database). Unset = the API runs stateless and /health reports
# db:"unconfigured". `npm run dev`, `npm run db:migrate` and drizzle-kit all
# load this file (from the backend/ directory) automatically.
#
# Direct connection (simplest for migrate + a long-running API):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Session pooler (IPv4-friendly client, same behavior as direct):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (:6543, PgBouncer — the client sees pgbouncer=true and
# disables prepared statements itself):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Local Postgres (no TLS) must opt out explicitly:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lawleit?sslmode=disable

# Optional — session cookie knobs (ticket 07). Defaults (SameSite=Lax, no
# Secure) match the reference backend and same-origin/proxied deploys. The
# production cross-site deploy (ticket 19: Vercel frontend, Fly API) must set
# COOKIE_SAMESITE=none AND COOKIE_SECURE=true — browsers ignore SameSite=None
# without Secure.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Optional — object storage for real file uploads (ticket 17, ADR-0002):
# Supabase Storage's S3-compatible API, same project as the database. Set all
# five S3_* variables together (a partial set fails boot); leave them all
# unset to run without storage — the upload/download routes then answer
# 503 "Storage not configured — set S3_* vars (see .env.example)" and the
# documents metadata surface keeps working.
#
# Owner paste-in (Supabase dashboard, the project from ticket 06):
#   S3_ENDPOINT            https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION              the project's region — ap-south-1 (Mumbai) per ADR-0002
#   S3_BUCKET              a PRIVATE bucket (Storage → New bucket), e.g. lawleit-documents
#   S3_ACCESS_KEY_ID       Storage → S3 access keys → create key pair (access key)
#   S3_SECRET_ACCESS_KEY   the matching secret (shown once at creation)
#
# S3_MAX_UPLOAD_MB caps POST /documents/sign-upload (default 25).
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_MAX_UPLOAD_MB=25

# Optional — transactional email (ticket 18): password-reset + user-invite
# emails through Resend, recorded durably in the email_outbox table with a
# retrying worker. All three are OPTIONAL:
#
#   RESEND_API_KEY unset → the "sender" is the server console: the reset/
#   invite link is printed in the API log (copy it by hand in dev — the same
#   handoff as the old stub), and the send is still recorded in email_outbox.
#   RESEND_API_KEY set   → the worker delivers via https://api.resend.com
#   (failures retry with exponential backoff; after 8 attempts the row is
#   marked failed and logged loudly as POISON).
#
# Owner steps (when ready to send real email):
#   1. Create a Resend account (resend.com) → API Keys → Create API Key.
#   2. Put the key and the from-envelope in backend/.env:
#        RESEND_API_KEY=re_xxxxxxxxxxxx
#        EMAIL_FROM=Lawleit <onboarding@resend.dev>
#      The default onboarding@resend.dev test sender only delivers to YOUR
#      Resend account's own email address — fine for development.
#   3. For production sending, add your domain in Resend → Domains (DNS
#      records: SPF/DKIM) and switch the envelope to it, e.g.
#        EMAIL_FROM=Lawleit <notifications@lawleit.in>
#      (the verified domain is a launch-time concern, not a dev blocker).
# APP_BASE_URL is the frontend base for the links inside the emails (the
# app's /reset-password route) — set it wherever the UI is deployed.
# RESEND_API_KEY=
# EMAIL_FROM=Lawleit <onboarding@resend.dev>
# APP_BASE_URL=http://localhost:5173

# Optional — HTTP port (default 3001)
# PORT=3001
